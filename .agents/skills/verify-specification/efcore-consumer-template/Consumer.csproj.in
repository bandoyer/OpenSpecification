<Project Sdk="Microsoft.NET.Sdk">

  <!-- verify efcore-consumer writes this as Consumer.csproj, with a reference to a tree's EF Core provider: its project,
       or, with the package option, its package in the tree's feed. The consumer targets net10.0 unless the framework
       option names another, and its SQL Server provider takes the EF Core version that the tree's
       Directory.Packages.props gives that framework, or else the tree's SQL Server provider version. For a tree whose
       DbSet extensions have #11's methods, it adds DBSET_READS to DefineConstants, and for a tree whose
       IReadRepositoryBase<T> has #16's AsAsyncEnumerable<TResult>, PROJECTED_ASYNC_ENUMERABLE, so the lines that call
       them build only against a tree that has them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>@FRAMEWORK@</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <DefineConstants>$(DefineConstants)@DEFINES@</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="@SQLSERVER@" />
    @PROVIDER@
  </ItemGroup>

</Project>
